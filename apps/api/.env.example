# Supabase Postgres via the pgbouncer transaction pooler (used at runtime — IPv4,
# handles many concurrent short-lived connections well). Direct host is IPv6-only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler, used only for migrations (pgbouncer transaction mode doesn't
# support the prepared statements / advisory locks Prisma Migrate needs).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="data-room-files"
CORS_ORIGIN="http://localhost:5173"
PORT=4000
MAX_UPLOAD_BYTES=52428800
