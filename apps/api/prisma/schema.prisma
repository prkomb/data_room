generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  dataRooms     DataRoom[]
  createdShares Share[]
}

model DataRoom {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders Folder[]
  files   File[]
  shares  Share[]

  @@index([ownerId])
}

model Folder {
  id         String   @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[] @relation("FolderChildren")
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  files File[]

  @@unique([dataRoomId, parentId, name])
  @@index([dataRoomId, parentId])
}

model File {
  id         String   @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name       String
  size       Int
  mimeType   String
  storageKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([dataRoomId, folderId, name])
  @@index([dataRoomId, folderId])
}

enum ResourceType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareMode {
  PUBLIC
  PERMISSIONED
}

enum ShareRole {
  VIEWER
}

model Share {
  id           String       @id @default(uuid())
  dataRoomId   String
  dataRoom     DataRoom     @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  resourceType ResourceType
  resourceId   String
  mode         ShareMode
  token        String?      @unique
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?

  grants ShareGrant[]

  @@index([resourceType, resourceId])
  @@index([dataRoomId])
}

model ShareGrant {
  id        String    @id @default(uuid())
  shareId   String
  share     Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userEmail String
  role      ShareRole @default(VIEWER)
  createdAt DateTime  @default(now())

  @@unique([shareId, userEmail])
  @@index([userEmail])
}
